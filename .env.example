# =====================================================================================
#  IMPERION FINANCE AI V17 — ortam değişkenleri / environment variables
#  Railway: Service -> Variables. Gerçek bir .env dosyasını ASLA GitHub'a göndermeyin.
# =====================================================================================

# ---- Mod / Mode ---------------------------------------------------------------------
# dry     = gerçek piyasa verisi, simüle dolumlar (API anahtarı gerekmez)   <- önerilen başlangıç
# testnet = Binance Futures Demo (demo-fapi.binance.com), sahte para, demo API anahtarı gerekir
# live    = gerçek Binance USDⓈ-M Futures hesabı (GERÇEK PARA)
MODE=dry

# Gerçek emir için anahtarlar + bu ifadenin birebir yazılması gerekir. Boş bırakılırsa sistem
# yalnızca analiz + sinyal + rapor üretir, hiçbir emir gönderemez (observe-only).
LIVE_TRADING_CONFIRM=
# Canlı kapısı: MODE=live ayrıca (1) emir yaşam döngüsünü geçmiş bir testnet-check kanıtı ve (2) bu kanıta bağlı
# elle onay ister:  python -m imperion approve-live --operator ADINIZ --confirm I_APPROVE_LIVE_TRADING
LIVE_GATE_MAX_AGE_DAYS=30   # testnet kanıtı bu kadar günden eskiyse kapı kapanır (1..90)
# Testnet kanıtını imzalayan / doğrulayan HMAC anahtarı (en az 32 karakter). Kanıtı üreten yerde (GitHub secret ya da
# testnet-check çalıştırdığınız makine) ve canlı sunucuda AYNI değer olmalı. Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
TESTNET_EVIDENCE_SECRET=

# ---- Binance API anahtarı (para çekme izni KAPALI, Futures açık, sunucu IP'sine kısıtlı) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Sermaye ve risk (varsayılanlar ~100 USDT için) ---------------------------------
TRADING_CAPITAL_USDT=100
RISK_PER_TRADE_PCT=0.25
MAX_CONCURRENT_POSITIONS=1
MAX_OPEN_RISK_PCT=0.50
MAX_DAILY_NEW_RISK_PCT=1.0
DAILY_LOSS_LIMIT_PCT=1.5
MAX_DRAWDOWN_PCT=5.0
CONSECUTIVE_LOSS_PAUSE=3
LOSS_PAUSE_MINUTES=240
LEVERAGE=2
MAX_LEVERAGE=2
MIN_EQUITY_USDT=20
KILL_SWITCH=false
TAKER_FEE_PCT=0.05
SLIPPAGE_PCT=0.03
MAX_COST_TO_RISK=0.20       # ücret+kayma riskin %20'sinden büyükse kurulum reddedilir
MAX_RISK_OVERSHOOT=1.25     # borsa minimumuna ulaşmak için risk en fazla %25 aşılabilir
MAX_SPREAD_PCT=0.06

# ---- Strateji ------------------------------------------------------------------------
# İşlem evreni (1..40 sembol). Varsayılan 16 sembol:
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,LTCUSDT,BCHUSDT,SUIUSDT,NEARUSDT,APTUSDT
ACTIVE_STYLES=scalp,day,swing
RADAR_COUNT=30              # tarama adayları; işlem izni ayrıca verilmedikçe yalnızca izleme
RADAR_DEEP_COUNT=5          # 1. kademede en iyi puanı alan kaç aday tam müdür analizine alınsın (0..10)
TELEGRAM_RADAR=true         # tarama listesindeki onaylı kurulumları "TARAMA — işlem açılmaz" etiketiyle gönder
WHALE_FLOOR_USDT=50000
REGIME_ADAPTIVE=true        # piyasa rejimine göre ajan ağırlıkları ve eşikler (false = sabit politika)
MAX_STREAM_LATENCY_MS=8000

# ---- Kalıcı depolama (Railway: /data'ya bağlı bir Volume ekleyin) --------------------
IMPERION_STORAGE_DIR=/data

# ---- HTTP (Railway PORT'u kendisi verir) ---------------------------------------------
ADMIN_TOKEN=                # >= 16 rastgele karakter; /status, /admin/* ve /dashboard verisini açar
TRADINGVIEW_WEBHOOK_SECRET= # >= 16 rastgele karakter; /webhook/tradingview'i açar

# ---- Telegram (sinyaller, 8 zaman dilimli analiz, işlem olayları, kritik uyarılar) ----
# 1) @BotFather -> /newbot -> token'ı kopyalayın. 2) Botunuza bir mesaj gönderin.
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates adresinden "chat":{"id": ...} değerini alın.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SIGNALS=approved   # approved = onaylı sinyaller | setups = analizce geçerli her kurulum | off
TELEGRAM_MIN_GRADE=B        # yayınlanacak en zayıf derece: B | A | A+
TELEGRAM_TRADES=true        # pozisyon açıldı / kapandı / başa-baş / izleyen stop mesajları
TELEGRAM_DIGEST_HOURS=4     # tüm sembollerin periyodik piyasa özeti; 0 = kapalı
TELEGRAM_COMMANDS=true      # /durum /analiz /piyasa /sinyaller /durdur /yardim (yalnızca TELEGRAM_CHAT_ID'den)

# ---- Günlük rapor e-postası (08:00 Europe/Istanbul) ---------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASS=                  # Gmail: normal şifre değil, "Uygulama şifresi"
MAIL_FROM=
MAIL_TO=
REPORT_HOUR=8
REPORT_TZ=Europe/Istanbul
ALERT_EMAIL=critical        # critical | trades | none

# ---- Yürütme -----------------------------------------------------------------------
ENTRY_MODE=market           # market | maker (en iyi alış/satışta post-only limit; ucuz ama dolmayabilir)
ENTRY_MAKER_WAIT_S=8
ENTRY_MAKER_FALLBACK=market # market = dolmazsa piyasa emri | skip = işlem yok
TRAIL_ATR_MULT=2.0          # TP1 sonrası stop mark fiyatını bu kadar ATR geriden izler; 0 = kapalı
FUNDING_BLOCK_MINUTES=10    # pozisyonun ödeyeceği büyük bir fonlamaya bu kadar dakika kala giriş yok ...
MAX_ADVERSE_FUNDING_PCT=0.05  # ... oran en az bu kadarsa (yüzde)
USER_STREAM=false           # dolumlarda guardian'ı anında uyandıran özel WebSocket (REST yine doğruluk kaynağıdır)
# USER_STREAM_PATH=private/ws   # açmadan önce Testnet'te ve güncel Binance belgesinde doğrulayın

# ---- Yapay zekâ (gölge öğrenme) -----------------------------------------------------
AI_MIN_SAMPLES=60           # bir şey öğrenmek için gereken çözülmüş gölge işlem sayısı (>= 20)
AI_CONTEXT_FILTER=true      # gölge kaydının KANITLANMIŞ şekilde negatif olduğu bağlamlarda kenarda dur
AI_VETO=true                # walk-forward ile DOĞRULANMIŞ model AI_MIN_WIN_PROB altını engelleyebilir
AI_MIN_WIN_PROB=0.30

# ---- Diğer --------------------------------------------------------------------------
LOG_LEVEL=INFO
# REQUIRE_STREAMS=true      # dry dışında zorunlu açık
# ALLOW_UNVERIFIED_KEY_PERMISSIONS=false

# ---- Uç nokta değişiklikleri (normalde GEREKMEZ) ------------------------------------
# BINANCE_REST_BASE=https://fapi.binance.com        # testnet varsayılanı: https://demo-fapi.binance.com
# BINANCE_TRADE_BASE=https://fapi.binance.com
# BINANCE_WS_BASE=wss://fstream.binance.com          # testnet varsayılanı: wss://demo-fstream.binance.com
# BINANCE_SPOT_BASE=https://api.binance.com

# ---- Radar: süreli işlem evreni kabulü (varsayılan KAPALI) ------------------------------
# Sabit SYMBOLS değişmez. Dinamik girişler yalnızca day stilinde değerlendirilir.
# Radar taraması tek başına emir göndermez. İzin listesi tek başına da yeterli değildir.
RADAR_TRADING_ENABLED=false
RADAR_TRADE_ALLOWLIST=
RADAR_MAX_ACTIVE=3
RADAR_MIN_QUOTE_VOLUME=10000000
RADAR_ADMISSION_TTL_SECONDS=1200
